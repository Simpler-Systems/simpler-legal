{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simpler.legal",
  "version": "0.1.0",
  "identifier": "legal.simpler.app",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "simpler.legal",
        "width": 1480,
        "height": 940,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Simpler Terminal Value Systems Pte Ltd",
    "copyright": "Copyright 2026 Simpler Terminal Value Systems Pte Ltd",
    "license": "Apache-2.0",
    "licenseFile": "installer-licence.txt",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "externalBin": ["binaries/node"],
    "resources": {
      "../../serve-legal.mjs": "engine/serve-legal.mjs",
      "../../strip-batch.mjs": "engine/strip-batch.mjs",
      "../../apply-v2.mjs": "engine/apply-v2.mjs",
      "../../apply-ln.mjs": "engine/apply-ln.mjs",
      "../../apply-lq.mjs": "engine/apply-lq.mjs",
      "../../locate-model.mjs": "engine/locate-model.mjs",
      "../../lib-core/": "engine/lib-core/",
      "../../lib-legal/": "engine/lib-legal/",
      "../../pii-bench/vocab-quasi.json": "engine/pii-bench/vocab-quasi.json",
      "../../pii-bench/vocab-keep.json": "engine/pii-bench/vocab-keep.json",
      "../../tools/launch-server.cmd": "engine/tools/launch-server.cmd",
      "../../llama-cuda/": "llama/",
      "../../LICENSE": "licenses/LICENSE",
      "../../NOTICE": "licenses/NOTICE",
      "../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../licenses/": "licenses/"
    }
  }
}
